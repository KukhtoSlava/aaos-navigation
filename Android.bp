package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The APK is built with Gradle by build-apk.sh (TomTom ships its SDK as Maven artifacts,
// which Soong cannot resolve). Run it before building the image.
android_app_import {
    name: "Navigation",
    apk: "prebuilt/Navigation.apk",
    certificate: "platform",
    system_ext_specific: true,
    // AAOS' default maps app; Navigation answers APP_MAPS in its place.
    overrides: ["CarMapsPlaceholder"],
    required: ["default-permissions-navigation"],
    // ~350 MB of TomTom native code and 16 dex files: preopt would only slow the build,
    // and the app is compiled on the device anyway.
    dex_preopt: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "default-permissions-navigation",
    src: "default-permissions-navigation.xml",
    // DefaultPermissionGrantPolicy only reads *.xml files
    filename_from_src: true,
    sub_dir: "default-permissions",
    system_ext_specific: true,
}

// The cluster map contract, compiled into the cluster app as well
// (vendor/autobox/apps/Cluster/Android.bp).
filegroup {
    name: "autobox-navigation-cluster-aidl",
    srcs: ["app/src/main/aidl/com/autobox/navigation/cluster/*.aidl"],
    path: "app/src/main/aidl",
    visibility: ["//vendor/autobox/apps/Cluster"],
}
